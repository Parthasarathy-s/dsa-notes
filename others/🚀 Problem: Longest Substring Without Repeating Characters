

def long_substring(str):
    ch_set = set()
    left = 0
    max_length = 0

    for right in range(len(str)):
        if str[right] in ch_set:
            ch_set.remove(str[left])
            left += 1
        
        ch_set.add(str[right])
        max_length = max(max_length, right - left + 1)

    return max_length




res = long_substring('abcabcabcd')
print(res)
